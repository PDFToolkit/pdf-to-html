{
    "name": "pdftoolkit/pdf-to-html",
    "type": "library",
    "description": "Semantic HTML from tagged PDF with explicit objects, source PDF MAC policy and authenticated permissions for PHP 8.3+",
    "keywords": [
        "pdf",
        "html",
        "tagged-pdf",
        "pdf-2.0",
        "accessibility",
        "derivation"
    ],
    "homepage": "https://pdftoolkit.github.io/modules/to-html/",
    "license": "MIT",
    "authors": [
        {
            "name": "Mathias STRASSER",
            "email": "contact@roukmoute.fr"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "pdftoolkit/pdf-reader": "^0.4.1 || ^0.5",
        "roukmoute/pdf": "^0.9",
        "php-64bit": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "PDF\\Html\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PDF\\Html\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff",
        "check": [
            "@test",
            "@analyse",
            "@format:check"
        ]
    },
    "support": {
        "issues": "https://github.com/PDFToolkit/pdf-to-html/issues",
        "source": "https://github.com/PDFToolkit/pdf-to-html",
        "docs": "https://pdftoolkit.github.io/modules/to-html/"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4.x-dev"
        }
    }
}
